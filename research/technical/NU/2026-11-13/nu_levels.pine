//@version=5
// NU research map 13.11.2026, schema technical-drawings/2. Generated by build_package_v2.py from the same numbers as drawings.json.
// Draws only display primary (on by default) and context (off by default, input toggle); hidden objects are not in this script.
// Research map only: not a trade plan, no orders, no alerts. NYSE:NU, 1D.
indicator("NU map 13.11.2026 v2", shorttitle="NU 1113 v2", overlay=true, max_boxes_count=20, max_lines_count=40, max_labels_count=40)
showPrimary = input.bool(true,  "Primary objects (decision lines, gap, zones, next report, note)")
showContext = input.bool(false, "Context objects (dimmed zones and the post-gap anchored VWAP)")
TZ = "America/New_York"
tStart = timestamp(TZ, 2026, 5, 15, 9, 30)
tEnd   = timestamp(TZ, 2027, 3, 31, 16, 0)
f_zone(float lo, float hi, string txt, color c, int transp, int tLeft, string ha) =>
    box.new(left=tLeft, top=hi, right=tEnd, bottom=lo, xloc=xloc.bar_time, bgcolor=color.new(c, transp), border_color=color.new(c, 55), border_width=1, text=txt, text_size=size.small, text_color=color.new(c, 0), text_halign=ha, text_valign=text.align_center)
f_level(float p, string txt, color c, int w) =>
    line.new(x1=tStart, y1=p, x2=tEnd, y2=p, xloc=xloc.bar_time, color=c, style=line.style_solid, width=w)
    label.new(x=tStart, y=p, text=txt, xloc=xloc.bar_time, style=label.style_label_right, color=color.new(c, 100), textcolor=c, size=size.small)
f_vline(int t, float yText, string txt, color c) =>
    line.new(x1=t, y1=10.0, x2=t, y2=20.0, xloc=xloc.bar_time, extend=extend.both, color=c, style=line.style_dashed, width=1)
    label.new(x=t, y=yText, text=txt, xloc=xloc.bar_time, style=label.style_label_down, color=color.new(c, 100), textcolor=c, size=size.small)
f_avwap(int anchor) =>
    var float pv = 0.0
    var float vv = 0.0
    if time >= anchor
        pv += hlc3 * volume
        vv += volume
    vv > 0 ? pv / vv : na
if barstate.islastconfirmedhistory
    if showPrimary
        f_zone(11.00, 11.21, "S 11.00-11.21 (2 touches)", #1b9e77, 78, tStart, text.align_right)
        f_zone(13.30, 13.53, "R 13.30-13.53 (6 touches)", #d6604d, 78, tStart, text.align_right)
        f_zone(13.00, 14.57, "area news gap 13.00-14.57 (26.10)", #7f7f7f, 78, timestamp(TZ, 2026, 10, 23, 9, 30), text.align_left)
        f_level(13.00, "TRIGGER: daily close > 13.00", #d6604d, 2)
        f_level(10.93, "INVALIDATION: daily close < 10.93", #1b9e77, 2)
        f_level(13.64, "BUY TEST 13.64 (12%/yr below)", #1f77b4, 2)
        f_vline(timestamp(TZ, 2027, 2, 22, 9, 30), 17.2, "Q4 report est. ~22.2 (unconfirmed)", #7b3294)
    if showContext
        f_zone(11.50, 11.64, "S 11.50-11.64 (2 touches)", #1b9e77, 90, tStart, text.align_right)
        f_zone(12.87, 13.04, "R 12.87-13.04 (1 touch)", #d6604d, 90, tStart, text.align_right)
        f_zone(13.75, 14.00, "R 13.75-14.00 (0 touches)", #d6604d, 90, tStart, text.align_right)
        f_zone(14.07, 14.28, "R 14.07-14.28 (1 touch)", #d6604d, 90, tStart, text.align_right)
var table tb = table.new(position.top_right, 1, 5, bgcolor=color.new(color.white, 10), border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast and showPrimary
    table.cell(tb, 0, 0, "NU 13.11.2026 | regime: risk-on | RS: lagging (12-1: -8.9% vs SPY +13.9%)", text_color=color.black, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 1, "Verdict: hold, do not add | close > 13 in 3 months: ~37% (Kent: probably not)", text_color=color.black, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 2, "Trigger: daily close > 13.00 | Invalidation: daily close < 10.93 (0.45 ATR below the 11.20 low)", text_color=color.black, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 3, "ATR 0.60 | next report: ~22.2.2027 (est.; historical avg move +/-7.3%)", text_color=color.black, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 4, "Fundamental vs technical: CONFLICT (cheap vs 13.64, RS falling, below SMA200)", text_color=color.black, text_size=size.small, text_halign=text.align_left)
av_gap = f_avwap(timestamp(TZ, 2026, 10, 26, 0, 0))
plot(showContext and timeframe.isdaily ? av_gap : na, "AVWAP from 26.10 gap (about 12.07 on 12.11)", color=color.new(#e08214, 30), linewidth=1, style=plot.style_linebr)
